# منفذ الخادم
PORT=3001

# رابط MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lexpro?retryWrites=true&w=majority

# مفتاح JWT للتشفير
JWT_SECRET=your-secret-key-here

# بيانات Mega للتخزين السحابي
MEGA_EMAIL=your-email@gmail.com
MEGA_PASSWORD=your-mega-password

# رابط الواجهة للسماح بـ CORS (ضع * للسماح للجميع)
CLIENT_URL=*
