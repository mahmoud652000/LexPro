{
  "name": "lexpro",
  "version": "1.0.0",
  "private": true,
  "description": "نظام إدارة مكاتب المحاماة - LEX PRO",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/renderer",
    "packages/main"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:server": "npm run dev -w @lexpro/server",
    "dev:renderer": "npm run dev -w @lexpro/renderer",
    "dev:main": "wait-on http://localhost:5173 && scripts\\start-main.cmd",
    "build": "npm run build:renderer && npm run build:server && npm run build:main",
    "build:renderer": "npm run build -w @lexpro/renderer",
    "build:server": "npm run build -w @lexpro/server",
    "build:main": "npm run build -w @lexpro/main",
    "package": "npm run build && electron-builder --config electron-builder.json",
    "lint": "eslint packages/*/src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron-builder": "^25.1.8",
    "sqlite3": "^6.0.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "electron": "^43.1.1"
  }
}
